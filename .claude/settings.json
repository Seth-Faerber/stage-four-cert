{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ \"$COE_MODE\" = promotion ] && exit 0; /Users/seth.faerber/Library/Python/3.9/bin/coe runtime-check --from-hook'",
            "timeout": 90,
            "statusMessage": "Evaluating skill output...",
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
