{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ \"$COE_MODE\" = promotion ] && exit 0; coe runtime-check --from-hook'"
          }
        ]
      }
    ]
  }
}
